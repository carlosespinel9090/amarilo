{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amarilo",
  "compatibility_date": "2026-08-05",
  "main": "./worker/assets-guard.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
